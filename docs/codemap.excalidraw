      "updated": 1791082457475,
      "created": 1791082437839,
      "link": null,
      "locked": false,
      "text": "Hide the progress UI if it is visible.",
      "fontSize": 10.202061770992081,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hide the progress UI if it is visible.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "iwpJTr20K4Di8P_12qDp8",
      "type": "text",
      "x": 1419.5087767798127,
      "y": -2228.635796316849,
      "width": 168.3426384573766,
      "height": 18.218925538562736,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#96f2d7",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOF",
      "roundness": null,
      "seed": 417718304,
      "version": 250,
      "versionNonce": 318397472,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791082569431,
      "created": 1791082567497,
      "link": null,
      "locked": false,
      "text": "It disconnects the active MutationObserver\ninstance.",
      "fontSize": 7.287570215425094,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It disconnects the active MutationObserver instance.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-XvP_NQUNh1R47unT6uDH",
      "type": "text",
      "x": 1419.888159860363,
      "y": -2205.862139393646,
      "width": 172.35079651588558,
      "height": 18.218925538562736,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#96f2d7",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOG",
      "roundness": null,
      "seed": 494197792,
      "version": 240,
      "versionNonce": 1469700128,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791082569431,
      "created": 1791082567497,
      "link": null,
      "locked": false,
      "text": "It then sets the observer variable to null,\nhalting all future DOM mutation monitoring.",
      "fontSize": 7.287570215425094,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It then sets the observer variable to null, halting all future DOM mutation monitoring.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
