      "boundElements": [],
      "updated": 1790891289773,
      "created": 1790891247696,
      "link": null,
      "locked": false,
      "text": "It disconnects the active MutationObserver\ninstance.",
      "fontSize": 7.287570215425094,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It disconnects the active MutationObserver instance.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Ku22zQzwIBOfkdfHjcEU8",
      "type": "text",
      "x": -1896.9376324762516,
      "y": -2210.648757886686,
