      "index": "b7o",
      "roundness": null,
      "seed": 1147244603,
      "version": 260,
      "versionNonce": 2019572571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790921709037,
      "created": 1790921706688,
      "link": null,
      "locked": false,
      "text": "It then sets the observer variable to null,\nhalting all future DOM mutation monitoring.",
      "fontSize": 7.287570215425094,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It then sets the observer variable to null, halting all future DOM mutation monitoring.",
