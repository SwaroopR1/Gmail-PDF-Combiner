      "boundElements": [],
      "updated": 1790976875931,
      "created": 1790938491858,
      "link": null,
      "locked": false,
      "text": "4. For each element, create an absolute URL using the decoded href\nvalue and baseUrl.\n\n",
      "fontSize": 4.085800886880793,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. For each element, create an absolute URL using the decoded href value and baseUrl.\n\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
