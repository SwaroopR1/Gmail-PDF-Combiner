      "created": 1790935210763,
      "link": null,
      "locked": false,
      "text": "2. Use fetch() on the URL and read the body of the response as a plain string.\n\n3. let html = null;  and  const baseUrl = `https://mail.google.com/mail/u/${u}/`;\n",
      "fontSize": 3.8787771583771216,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Use fetch() on the URL and read the body of the response as a plain string.\n\n3. let html = null;  and  const baseUrl = `https://mail.google.com/mail/u/${u}/`;\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
