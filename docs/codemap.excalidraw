      "boundElements": [],
      "updated": 1790921709037,
      "created": 1790921706688,
      "link": null,
      "locked": false,
      "text": "It disconnects the active MutationObserver\ninstance.",
      "fontSize": 7.287570215425094,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It disconnects the active MutationObserver instance.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "paXhvkw10k-W1ja8PE-If",
      "type": "text",
      "x": -970.1236918089317,
      "y": -2234.0199838518897,
      "width": 172.35079651588558,
      "height": 18.218925538562736,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#96f2d7",
      "fillStyle": "solid",
